# Bot StepFather Configuration
# Copy this file to .env and fill in the values

# OAuth token of the Bot StepFather bot in Yandex Messenger
# Create the bot at https://admin.yandex.ru/bot-platform
BSF_STEPFATHER_TOKEN=your_bot_oauth_token_here

# Public URL where the adapter is accessible (used for webhook forwarding)
BSF_ADAPTER_PUBLIC_URL=https://your-server.example.com

# Adapter server bind settings
BSF_ADAPTER_HOST=0.0.0.0
BSF_ADAPTER_PORT=8081

# Database URL (SQLite by default)
BSF_DATABASE_URL=sqlite+aiosqlite:///bot_registry.db

# Yandex Messenger Bot API base URL (usually no need to change)
BSF_YANDEX_API_BASE=https://botapi.messenger.yandex.net/bot/v1

# Polling interval for Yandex getUpdates (seconds)
BSF_YM_POLL_INTERVAL=1.0

# Max long-polling timeout for TG-compatible getUpdates (seconds)
BSF_TG_LONG_POLL_MAX_TIMEOUT=50
