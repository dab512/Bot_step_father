# Bot StepFather Configuration
# Copy this file to .env and fill in the values

# ============================================================
# REQUIRED: Bot StepFather's own Yandex Messenger token
# Create the bot at https://admin.yandex.ru/bot-platform
# ============================================================
BSF_STEPFATHER_TOKEN=your_bot_oauth_token_here

# Public URL where the adapter is accessible (used for webhook forwarding)
BSF_ADAPTER_PUBLIC_URL=https://your-server.example.com

# Adapter server bind settings
BSF_ADAPTER_HOST=0.0.0.0
BSF_ADAPTER_PORT=8081

# Database URL (SQLite by default)
BSF_DATABASE_URL=sqlite+aiosqlite:///bot_registry.db

# Yandex Messenger Bot API base URL
BSF_YANDEX_API_BASE=https://botapi.messenger.yandex.net/bot/v1

# Yandex Messenger Client API base URL (for user-as-bot mode)
BSF_YANDEX_CLIENT_API_BASE=https://api.messenger.yandex.ru

# Polling interval for Yandex getUpdates (seconds)
BSF_YM_POLL_INTERVAL=1.0

# Max long-polling timeout for TG-compatible getUpdates (seconds)
BSF_TG_LONG_POLL_MAX_TIMEOUT=50

# ============================================================
# FOR AUTOMATED BOT CREATION (/createbot command)
# ============================================================

# OAuth app credentials (register at https://oauth.yandex.ru/client/new/)
# The app must request the yamb:all scope for Client API access
BSF_OAUTH_CLIENT_ID=
BSF_OAUTH_CLIENT_SECRET=

# Yandex 360 Admin API credentials
# Token must have ya360_admin:directory_write scope
BSF_YANDEX360_OAUTH_TOKEN=
BSF_YANDEX360_ORG_ID=

# ============================================================
# FOR YC CLI INTEGRATION (optional, service account provisioning)
# ============================================================
BSF_YC_FOLDER_ID=
BSF_YC_CLOUD_ID=
BSF_YC_PROFILE=
